# Winify configuration
#
# Copy this file to `.env` and fill in your own Spotify Client ID:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
#
# To get a Client ID:
#   1. Go to https://developer.spotify.com/dashboard and create an app
#   2. Add this Redirect URI, exactly:
#        http://127.0.0.1:8888/callback
#   3. Copy the app's Client ID below
#
# Winify uses the Authorization Code flow with PKCE, so no Client Secret is
# needed. Don't put one here.

SPOTIFY_CLIENT_ID=
