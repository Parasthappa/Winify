const { app, BrowserWindow, ipcMain, shell } = require('electron');
const crypto = require('crypto');
const fs = require('fs');
const http = require('http');
const path = require('path');

try {
  process.loadEnvFile(path.join(__dirname, '.env'));
} catch {
  // No .env file; the login button will report the missing Client ID.
}

const CLIENT_ID = process.env.SPOTIFY_CLIENT_ID;
const REDIRECT_URI = 'http://127.0.0.1:8888/callback';
const SCOPES = [
  'user-read-playback-state',
  'user-read-currently-playing',
  'user-modify-playback-state',
];
const POLL_MS = 5000;

let win;
let tokens = null; // { accessToken, refreshToken, expiresAt }
let pollTimer = null;

function send(channel, payload) {
  if (win && !win.isDestroyed()) win.webContents.send(channel, payload);
}

function setStatus(text) {
  send('status', text);
}

function createWindow() {
  win = new BrowserWindow({
    width: 800,
    height: 600,
    webPreferences: {
      preload: path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
    },
  });
  win.loadFile('index.html');
  win.webContents.on('did-finish-load', restoreSession);
}

// --- Saved session --------------------------------------------------------

function tokenFile() {
  return path.join(app.getPath('userData'), 'tokens.json');
}

function saveTokens() {
  try {
    fs.writeFileSync(tokenFile(), JSON.stringify(tokens), { mode: 0o600 });
  } catch {
    // Not fatal: the user just has to log in again next launch.
  }
}

function signOut() {
  tokens = null;
  clearInterval(pollTimer);
  try {
    fs.rmSync(tokenFile(), { force: true });
  } catch {
    // Nothing to clean up.
  }
  send('auth', false);
}

// Runs on every launch: if a refresh token was saved, trade it for a fresh
// access token and go straight to the app screen.
async function restoreSession() {
  let saved;
  try {
    saved = JSON.parse(fs.readFileSync(tokenFile(), 'utf8'));
  } catch {
    send('auth', false);
    return;
  }

  if (!saved || !saved.refreshToken || !CLIENT_ID) {
    send('auth', false);
    return;
  }

  tokens = saved;
  try {
    await refreshTokens();
  } catch {
    // Token was revoked or expired; fall back to the login screen.
    signOut();
    setStatus('Session expired. Please log in again.');
    return;
  }

  send('auth', true);
  setStatus('Waiting for current song...');
  startPolling();
}

// --- Token handling -------------------------------------------------------

async function requestToken(params) {
  const res = await fetch('https://accounts.spotify.com/api/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({ client_id: CLIENT_ID, ...params }),
  });
  if (!res.ok) throw new Error(`Token request failed (${res.status})`);
  const data = await res.json();
  tokens = {
    accessToken: data.access_token,
    refreshToken: data.refresh_token || (tokens && tokens.refreshToken),
    expiresAt: Date.now() + data.expires_in * 1000,
  };
  saveTokens();
}

function refreshTokens() {
  return requestToken({ grant_type: 'refresh_token', refresh_token: tokens.refreshToken });
}

// --- Login (Authorization Code with PKCE) ---------------------------------

function login() {
  if (!CLIENT_ID) {
    setStatus('Missing SPOTIFY_CLIENT_ID in .env');
    return;
  }

  const verifier = crypto.randomBytes(64).toString('base64url');
  const challenge = crypto.createHash('sha256').update(verifier).digest('base64url');
  const state = crypto.randomBytes(16).toString('hex');

  const server = http.createServer(async (req, res) => {
    const url = new URL(req.url, REDIRECT_URI);
    if (url.pathname !== '/callback') {
      res.writeHead(404).end();
      return;
    }

    const code = url.searchParams.get('code');
    const ok = code && url.searchParams.get('state') === state;
    res.writeHead(ok ? 200 : 400, { 'Content-Type': 'text/plain' });
    res.end(ok ? 'Logged in. You can close this tab.' : 'Login failed. You can close this tab.');
    server.close();

    if (!ok) {
      setStatus('Login failed or was cancelled');
      return;
    }

    try {
      await requestToken({
        grant_type: 'authorization_code',
        code,
        redirect_uri: REDIRECT_URI,
        code_verifier: verifier,
      });
      send('auth', true);
      setStatus('Logged in. Waiting for current song...');
      startPolling();
    } catch (err) {
      setStatus(err.message);
    }
  });

  server.on('error', (err) => setStatus(`Could not start login listener: ${err.message}`));

  server.listen(8888, '127.0.0.1', () => {
    const authUrl = new URL('https://accounts.spotify.com/authorize');
    authUrl.search = new URLSearchParams({
      response_type: 'code',
      client_id: CLIENT_ID,
      scope: SCOPES.join(' '),
      redirect_uri: REDIRECT_URI,
      state,
      code_challenge_method: 'S256',
      code_challenge: challenge,
    }).toString();
    shell.openExternal(authUrl.toString());
    setStatus('Waiting for you to log in in your browser...');
  });
}

// --- Current song ---------------------------------------------------------

async function pollCurrentSong() {
  if (!tokens) return;

  if (Date.now() > tokens.expiresAt - 30000) {
    try {
      await refreshTokens();
    } catch {
      signOut();
      setStatus('Session expired. Please log in again.');
      return;
    }
  }

  try {
    const res = await fetch('https://api.spotify.com/v1/me/player/currently-playing', {
      headers: { Authorization: `Bearer ${tokens.accessToken}` },
    });

    if (res.status === 204) {
      setStatus('Nothing is playing');
    } else if (res.status === 200) {
      const data = await res.json();
      const item = data.item;
      if (!item) {
        setStatus('Nothing is playing');
      } else {
        const artist = item.artists
          ? item.artists.map((a) => a.name).join(', ')
          : (item.show && item.show.name) || 'Unknown';
        setStatus(`${item.name} — ${artist}`);
      }
    } else if (res.status === 401) {
      signOut();
      setStatus('Session expired. Please log in again.');
    } else if (res.status !== 429) {
      setStatus(`Spotify returned an error (${res.status})`);
    }
  } catch (err) {
    setStatus(`Error: ${err.message}`);
  }
}

function startPolling() {
  clearInterval(pollTimer);
  pollCurrentSong();
  pollTimer = setInterval(pollCurrentSong, POLL_MS);
}

// --- App lifecycle --------------------------------------------------------

ipcMain.on('login', login);

app.whenReady().then(createWindow);

app.on('window-all-closed', () => {
  app.quit();
});
